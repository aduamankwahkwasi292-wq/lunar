{
  "name": "lunar-desktop",
  "version": "3.0.2",
  "description": "MrSOLIS — your study tutor, on your own computer.",
  "author": "Kwasi Kwakye & Alex Nyanteng",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^5.9.0",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "com.lunar.classroom",
    "productName": "Lunar",
    "copyright": "Copyright © 2026 Kwasi Kwakye & Alex Nyanteng",
    "publish": [
      {
        "provider": "github",
        "owner": "aduamankwahkwasi292-wq",
        "repo": "lunar",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/harden.js",
    "files": [
      "main.js",
      "preload.js",
      "updates.js",
      "licence.js",
      "splash.html",
      "activate.html"
    ],
    "extraResources": [
      {
        "from": "../dist/lunar-backend",
        "to": "backend"
      },
      {
        "from": "../models",
        "to": "models",
        "filter": [
          "voice/**",
          "!voice/**/test_wavs/**"
        ]
      },
      {
        "from": "../runtime/llama.cpp",
        "to": "runtime/llama.cpp",
        "filter": [
          "llama-server*",
          "*.dll",
          "*.so",
          "*.so.*",
          "*.dylib",
          "LICENSE*"
        ]
      },
      {
        "from": "../runtime/ffmpeg",
        "to": "runtime/ffmpeg"
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Lunar-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "license": "build/license.txt",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lunar"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "artifactName": "Lunar-${version}.${ext}"
    },
    "dmg": {
      "title": "Lunar ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "artifactName": "Lunar-${version}.${ext}",
      "maintainer": "Kwasi Kwakye & Alex Nyanteng"
    },
    "appx": {
      "identityName": "BehemothGroup.MrSOLIS",
      "publisher": "CN=74046C7E-54C1-4825-BA8C-244437F275D1",
      "publisherDisplayName": "Behemoth Group",
      "applicationId": "MrSOLIS",
      "displayName": "MrSOLIS",
      "backgroundColor": "#000000",
      "languages": [
        "en-US"
      ],
      "artifactName": "MrSOLIS-${version}.${ext}"
    }
  }
}
